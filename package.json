{
  "name": "@davidsneighbour/draft-pipeline",
  "version": "0.3.0",
  "description": "Reusable markdown-to-pdf and optional reMarkable upload toolkit",
  "type": "module",
  "bin": {
    "draft": "./src/cli.mjs",
    "draft-pipeline": "./src/cli.mjs"
  },
  "scripts": {
    "css": "node ./src/cli.mjs css",
    "pdf": "node ./src/cli.mjs pdf",
    "upload": "node ./src/cli.mjs upload",
    "build": "node ./src/cli.mjs build",
    "check": "node --check ./src/*.mjs",
    "release": "npm run check && npm test && release-it --config .release-it.ts",
    "release:pre": "release-it --config .release-it.ts --preRelease=rc",
    "test": "node --test"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.3",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "marked": "18.0.9",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@cspell/dict-en-gb": "5.0.30",
    "@release-it/conventional-changelog": "11.0.0",
    "release-it": "20.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}